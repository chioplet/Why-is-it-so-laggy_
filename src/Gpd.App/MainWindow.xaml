<Window x:Class="Gpd.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="wiisl — Why is it so laggy?" Height="860" Width="1320"
        MinHeight="640" MinWidth="1080"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：标题 + 环境状态 ============ -->
        <Border Grid.Row="0" Background="#FFF3F6FA" BorderBrush="#FFCBD5E1" BorderThickness="1"
                CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="wiisl" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="Why is it so laggy?" FontSize="13" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="#FF64748B" />
                    <TextBlock x:Name="TxtElevation" Margin="14,0,0,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="#FFB45309" Text="权限：检测中…" />
                    <Button x:Name="BtnProbe" Content="重新检测环境" Click="BtnProbe_Click"
                            HorizontalAlignment="Right" Margin="16,0,0,0" />
                    <Button x:Name="BtnRestartElevated" Content="以管理员身份重新启动"
                            Click="BtnRestartElevated_Click" Margin="6,0,0,0"
                            ToolTip="只有帧率模块（PresentMon）需要管理员权限；不重启也能正常采集其它全部指标" />
                </StackPanel>
                <TextBlock x:Name="TxtMachine" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF334155"
                           Text="正在读取机器信息…" />
            </StackPanel>
        </Border>

        <!-- ============ 主体：左选目标 / 右监控与报告 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧：目标选择 ========== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <!-- 任意进程 -->
                    <TabItem Header="任意进程">
                        <DockPanel Margin="4">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="TxtProcessFilter" Width="180" VerticalContentAlignment="Center"
                                         ToolTip="按进程名或 PID 过滤" TextChanged="TxtProcessFilter_TextChanged" />
                                <Button Content="刷新列表" Click="BtnRefreshProcesses_Click" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" x:Name="TxtProcessCount" Foreground="#FF64748B"
                                       Margin="0,4,0,0" Text="尚未加载" />
                            <ListBox x:Name="LstProcesses" SelectionChanged="LstProcesses_SelectionChanged"
                                     DisplayMemberPath="Display" />
                        </DockPanel>
                    </TabItem>

                    <!-- 游戏库 -->
                    <TabItem Header="游戏库">
                        <DockPanel Margin="4">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnScanGames" Content="扫描游戏库" Click="BtnScanGames_Click" />
                                    <CheckBox x:Name="ChkStandalone" Content="含独立安装" VerticalAlignment="Center"
                                              ToolTip="扫描注册表卸载项，误报率较高" />
                                </StackPanel>
                                <TextBlock x:Name="TxtGameCount" Foreground="#FF64748B" Margin="0,4,0,0"
                                           Text="尚未扫描" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListBox x:Name="LstGames" SelectionChanged="LstGames_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#FF64748B"
                                                       FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>

                <!-- 已选目标 -->
                <Border Grid.Row="1" Background="#FFECFDF5" BorderBrush="#FF6EE7B7" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="当前目标" FontWeight="Bold" Foreground="#FF065F46" />
                        <TextBlock x:Name="TxtTarget" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="未选择。请从左侧挑一个进程或游戏。" />
                        <TextBlock x:Name="TxtTargetGame" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="#FF065F46" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- ========== 右侧：监控 + 报告 ========== -->
            <TabControl Grid.Column="2">
                <!-- ===== 实时监控 ===== -->
                <TabItem Header="实时监控">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="200" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="采样设置">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="采样间隔（秒）" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtInterval" Width="60" Margin="6,0,16,0"
                                             VerticalContentAlignment="Center" Text="1" />
                                    <TextBlock Text="采集时长（秒，留空=手动停止）" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtDuration" Width="70" Margin="6,0,16,0"
                                             VerticalContentAlignment="Center" Text="" />
                                    <CheckBox x:Name="ChkFps" Content="启用帧率模块（需管理员）" VerticalAlignment="Center"
                                              Margin="0,0,16,0" />
                                    <CheckBox x:Name="ChkStopOnExit" Content="游戏退出即停止" IsChecked="True"
                                              VerticalAlignment="Center" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BtnStart" Content="开始采样" Click="BtnStart_Click"
                                            FontWeight="Bold" Padding="16,6" />
                                    <Button x:Name="BtnStop" Content="停止采样" Click="BtnStop_Click"
                                            IsEnabled="False" Padding="16,6" />
                                    <Button x:Name="BtnQuickAnalyze" Content="停止并生成报告" Click="BtnQuickAnalyze_Click"
                                            Padding="16,6" IsEnabled="False" />
                                </StackPanel>

                                <TextBlock x:Name="TxtSampleStatus" Margin="0,8,0,0" Foreground="#FF334155"
                                           Text="未开始。" TextWrapping="Wrap" />
                                <ProgressBar x:Name="BarProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="实时读数">
                            <UniformGrid x:Name="GridLive" Columns="4" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="曲线（CPU / GPU 占用，% 与频率）">
                            <sp:WpfPlot x:Name="Plot" />
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ===== 诊断报告 ===== -->
                <TabItem Header="诊断报告">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="输出设置">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="输出目录" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtOutputDir" Width="420" Margin="6,0,6,0"
                                             VerticalContentAlignment="Center" />
                                    <Button Content="浏览…" Click="BtnBrowseOutput_Click" />
                                    <Button Content="打开目录" Click="BtnOpenOutput_Click" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="输出格式" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox x:Name="ChkMd" Content="Markdown" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkPdf" Content="PDF" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkCsv" Content="CSV" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkJson" Content="JSON" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <CheckBox x:Name="ChkAutoOpen" Content="生成后自动打开目录" VerticalAlignment="Center" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BtnGenerate" Content="生成报告" Click="BtnGenerate_Click"
                                            FontWeight="Bold" Padding="16,6" IsEnabled="False" />
                                    <TextBlock x:Name="TxtReportStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="#FF334155" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="结论速览">
                            <TextBlock x:Name="TxtFindingsSummary" TextWrapping="Wrap" MaxHeight="90"
                                       Foreground="#FF334155" Text="还没有数据。先采样，再生成报告。" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="详细结论与建议">
                            <ListBox x:Name="LstFindings">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,3">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{Binding BadgeBackground}" CornerRadius="3"
                                                            Padding="6,1" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SeverityText}" Foreground="White"
                                                                   FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Evidence}" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="#FF334155" />
                                                <TextBlock Text="{Binding Explanation}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Foreground="#FF475569" />
                                                <TextBlock Text="{Binding Recommendations}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Foreground="#FF1D4ED8" />
                                                <TextBlock Text="{Binding ExpectedGain}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Foreground="#FF047857" FontStyle="Italic" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ============ 底部日志 ============ -->
        <GroupBox Grid.Row="2" Header="运行日志" Margin="0,10,0,0">
            <TextBox x:Name="TxtLog" Height="110" IsReadOnly="True" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
